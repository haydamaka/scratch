new file mode 100644
index 0000000..4db67f8
--- /dev/null
+++ b/app/rag/er_filter.py
@@ -0,0 +1,113 @@
+"""
+Relationship-graph filtering of the fused candidate pool.
+
+Both search arms score a table on how well its *documented surface* matches the
+question. A table that belongs in the answer only because the expected SQL
+joins it has no such surface: ``fact_amounts`` is a ground-truth table for
+questions about tenor and utilisation, yet its name, description and column
+list mention neither — it is reached through ``fact_facility`` on
+``(entity_id, entity_version)``. No embedding or BM25 tuning recovers that
+class of table, because there is nothing to match.
+
+So the pool is read in two parts. The head of the fused ranking is kept
+unconditionally — those are the tables the question actually describes. Below
+it, a much deeper slice is admitted only where the relationship graph connects
+a candidate to that head, which is what turns "ranked 40th by text similarity"
+into "one join away from a confirmed hit".
+
+Public API:
+    ``filter_pool_by_er(pool_ids, anchor_n, expand_n)``  ``(head, expanded)``
+"""
+
+from __future__ import annotations
+
+from app.core.logger import get_logger
+
+logger = get_logger(__name__)
+
+# get_table_connections() truncates to its highest-confidence edges. This is a
+# reachability test, not a ranking, so ask for all of them.
+_ALL_CONNECTIONS = 10_000
+
+
+def _normalize(table: str) -> str:
+    """Graph nodes are stored lowercased and stripped."""
+    return (table or "").lower().strip()
+
+
+def _neighbours(graph, table: str) -> "set[str]":
+    """Normalised names of every table sharing an edge with ``table``."""
+    info = graph.get_table_connections(table, max_connections=_ALL_CONNECTIONS)
+    if not info.get("exists"):
+        return set()
+
+    found: "set[str]" = set()
+    for edge in info.get("connections") or ():
+        # Outgoing edges name the far end 'target_table', incoming ones
+        # 'source_table'; direction is irrelevant for reachability.
+        other = edge.get("target_table") or edge.get("source_table")
+        if other:
+            found.add(_normalize(other))
+    return found
+
+
+def filter_pool_by_er(
+    pool_ids: "list[str]",
+    anchor_n: int,
+    expand_n: int,
+) -> "tuple[list[str], list[str]]":
+    """Split ``pool_ids`` into an unconditional head and its ER-connected tail.
+
+    Args:
+        pool_ids: Fused ranking, best first.
+        anchor_n: Size of the head kept unconditionally; also the anchor set.
+        expand_n: Maximum number of ER-connected tables admitted below it.
+
+    Returns:
+        ``(head, expanded)``. ``expanded`` preserves fused order, so a
+        well-ranked neighbour still outranks a poorly-ranked one.
+
+    When the graph cannot be loaded the tail is admitted unfiltered, which
+    degrades this to a plain deeper cut rather than failing the search.
+    """
+    head = pool_ids[:anchor_n]
+    tail = pool_ids[anchor_n:]
+
+    if not tail or expand_n <= 0:
+        return head, []
+
+    try:
+        # Imported here, not at module scope: building the graph reads the
+        # relationship source, and this module is otherwise import-light.
+        from app.utils.table_relationship_graph_builder_service import get_graph_instance
+        graph = get_graph_instance()
+    except Exception as exc:
+        logger.error(
+            "[er_filter] relationship graph unavailable (%s) — admitting the "
+            "top %d unfiltered.", exc, expand_n,
+        )
+        return head, tail[:expand_n]
+
+    neighbours: "set[str]" = set()
+    for anchor in head:
+        try:
+            neighbours |= _neighbours(graph, anchor)
+        except Exception as exc:
+            logger.warning("[er_filter] no connections for anchor '%s': %s", anchor, exc)
+
+    if not neighbours:
+        logger.info(
+            "[er_filter] none of the %d anchors has a graph edge — "
+            "admitting the top %d unfiltered.", len(head), expand_n,
+        )
+        return head, tail[:expand_n]
+
+    connected = [tid for tid in tail if _normalize(tid) in neighbours]
+    expanded = connected[:expand_n]
+
+    logger.info(
+        "[er_filter] %d/%d pool tables below the head are ER-connected to the "
+        "top %d; admitting %d.",
+        len(connected), len(tail), len(head), len(expanded),
+    )
+    return head, expanded
