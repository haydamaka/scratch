+++ b/app/rag/sqlite_shim.py
@@ -0,0 +1,17 @@
+"""
+Point ``sqlite3`` at pysqlite3 before anything imports chromadb.
+
+Chroma needs sqlite >= 3.35 and the interpreter's bundled module is often older,
+so every module that reaches a Chroma collection has to do this swap *before* its
+third-party imports. Importing this module performs it once; a second import is a
+no-op because ``pysqlite3`` is no longer in ``sys.modules`` to pop.
+
+    import app.rag.sqlite_shim  # noqa: F401  — must precede chromadb
+"""
+
+import os
+import sys
+
+if os.name == "posix" and "pysqlite3" not in sys.modules:
+    __import__("pysqlite3")
+    sys.modules["sqlite3"] = sys.modules.pop("pysqlite3")
