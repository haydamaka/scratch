@@ -0,0 +1,240 @@
+"""
+Embeddings for ENV=local, against a personal Google Cloud project.
+
+The corporate path (``embedding_vertex``) reaches Vertex through a COIN token
+roller built from R2D2 credentials, none of which exist off the corporate
+network. This module talks to the same model with a plain bearer token instead,
+and exposes the same vector-DB ``EmbeddingFunction`` interface, so documents and
+queries stay on one model without anything downstream knowing the difference.
+
+The token is short-lived — an hour — and a full catalog load takes minutes, so a
+401 mid-load re-reads the token once and retries rather than failing the batch.
+
+Token, in order: ``VERTEX_TOKEN``, the file named by ``VERTEX_TOKEN_FILE``
+(``.vertex_token`` in the project root by default), then whatever gcloud prints.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import time
+import urllib.error
+import urllib.request
+from pathlib import Path
+
+from app.core.logger import get_logger
+
+logger = get_logger(__name__)
+
+_ROOT_DIR = Path(__file__).resolve().parents[2]
+
+PROJECT_ENV = "VERTEXAI_PROJECT"
+REGION_ENV = "VERTEX_REGION"
+MODEL_ENV = "VERTEX_EMBED_MODEL"
+TOKEN_FILE_ENV = "VERTEX_TOKEN_FILE"
+
+DEFAULT_REGION = "us-central1"
+DEFAULT_MODEL = "text-embedding-005"
+DEFAULT_TOKEN_FILE = ".vertex_token"
+
+EMBED_TIMEOUT_SECONDS = float(os.getenv("EMBED_CALL_TIMEOUT_SECONDS", "60"))
+
+# A personal project's per-minute request quota is small — a dozen or so calls —
+# and a full catalog load needs many more than that. Waiting for the window to
+# refill is the difference between a slow load and a half-empty collection.
+QUOTA_BACKOFF_SECONDS = float(os.getenv("VERTEX_QUOTA_BACKOFF_SECONDS", "30"))
+QUOTA_MAX_ATTEMPTS = int(os.getenv("VERTEX_QUOTA_MAX_ATTEMPTS", "8"))
+
+# Set VERTEX_EMBED_CACHE=0 to measure real latency, or after changing the model.
+_CACHE_ENABLED = os.getenv("VERTEX_EMBED_CACHE", "1").strip() not in ("0", "false")
+
+
+def _token_file() -> Path:
+    path = Path(os.getenv(TOKEN_FILE_ENV) or DEFAULT_TOKEN_FILE)
+    return path if path.is_absolute() else (_ROOT_DIR / path)
+
+
+def access_token() -> str:
+    """Fetch a bearer token, or say precisely what to do about it."""
+    token = (os.getenv("VERTEX_TOKEN") or "").strip()
+    if token:
+        return token
+
+    path = _token_file()
+    if path.exists():
+        token = path.read_text(encoding="utf-8").strip()
+        if token:
+            return token
+
+    for command in (["gcloud", "auth", "print-access-token"],
+                    [os.path.expanduser("~/google-cloud-sdk/bin/gcloud"),
+                     "auth", "print-access-token"]):
+        try:
+            done = subprocess.run(command, capture_output=True, text=True, check=True)
+        except Exception:
+            continue
+        if done.stdout.strip():
+            return done.stdout.strip()
+
+    raise RuntimeError(
+        f"No Vertex token for ENV=local. Write one to {path}, set VERTEX_TOKEN, "
+        f"or run `gcloud auth login`. (`gcloud auth print-access-token > {path}` "
+        f"refreshes it; tokens last about an hour.)"
+    )
+
+
+def _endpoint() -> str:
+    project = os.getenv(PROJECT_ENV)
+    if not project:
+        raise RuntimeError(
+            f"{PROJECT_ENV} is not set — ENV=local needs a Google Cloud project "
+            f"to embed against (see .env.local)."
+        )
+    region = os.getenv(REGION_ENV) or DEFAULT_REGION
+    model = os.getenv(MODEL_ENV) or DEFAULT_MODEL
+    return (f"https://{region}-aiplatform.googleapis.com/v1/projects/{project}"
+            f"/locations/{region}/publishers/google/models/{model}:predict")
+
+
+def _post(url: str, body: bytes, token: str) -> dict:
+    request = urllib.request.Request(
+        url, data=body,
+        headers={"Authorization": f"Bearer {token}",
+                 "Content-Type": "application/json"},
+    )
+    with urllib.request.urlopen(request, timeout=EMBED_TIMEOUT_SECONDS) as response:
+        return json.load(response)
+
+
+def _retry_after(exc: urllib.error.HTTPError, attempt: int) -> float:
+    """Seconds to wait before retrying a throttled request."""
+    header = exc.headers.get("Retry-After") if exc.headers else None
+    if header:
+        try:
+            return float(header)
+        except ValueError:
+            pass
+    # The quota refills on a per-minute window, so back off in that order of
+    # magnitude rather than in milliseconds.
+    return min(QUOTA_BACKOFF_SECONDS * attempt, 120.0)
+
+
+def _cache_path(task: str) -> Path:
+    storage = os.getenv("VECTORDB_STORAGE_PATH") or str(_ROOT_DIR / "data")
+    model = os.getenv(MODEL_ENV) or DEFAULT_MODEL
+    return Path(storage) / "embedding_cache" / f"{model}-{task}.json"
+
+
+def _load_cache(task: str, caching: bool) -> dict:
+    """Query embeddings already paid for, keyed by the text itself.
+
+    A sweep runs the same questions through every configuration, so without this
+    the twenty-fifth run spends exactly as much quota as the first for identical
+    vectors. Only queries are cached: documents are embedded once per load, and
+    keeping a thousand of them here would be a large file for no reuse.
+    """
+    if not caching:
+        return {}
+    path = _cache_path(task)
+    if not path.exists():
+        return {}
+    try:
+        cache = json.loads(path.read_text(encoding="utf-8"))
+    except Exception as exc:
+        logger.warning("[embedding] ignoring unreadable cache %s: %s", path, exc)
+        return {}
+    logger.info("[embedding] query cache: %d entr(ies) from %s", len(cache), path)
+    return cache
+
+
+def _save_cache(cache: dict) -> None:
+    path = _cache_path("RETRIEVAL_QUERY")
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_suffix(".tmp")
+    tmp.write_text(json.dumps(cache), encoding="utf-8")
+    tmp.replace(path)
+
+
+def make_local_embedding_fn(task: str = "RETRIEVAL_QUERY"):
+    """A vector-DB EmbeddingFunction over Vertex, authenticated by bearer token."""
+    from chromadb.api.types import Documents, EmbeddingFunction, Embeddings
+
+    url = _endpoint()
+    # Fail here rather than on the first batch, when a load is already underway.
+    state = {"token": access_token()}
+    logger.info(
+        "[embedding] ENV=local — %s via %s (task=%s), bearer token from %s.",
+        os.getenv(MODEL_ENV) or DEFAULT_MODEL, os.getenv(PROJECT_ENV), task,
+        "VERTEX_TOKEN" if os.getenv("VERTEX_TOKEN") else _token_file(),
+    )
+
+    # Only queries are worth caching: documents are embedded once per load, and a
+    # sweep re-runs the same questions through every configuration.
+    caching = _CACHE_ENABLED and task == "RETRIEVAL_QUERY"
+    cache = _load_cache(task, caching)
+
+    class _LocalVertexFn(EmbeddingFunction):
+        def __call__(self, input: Documents) -> Embeddings:
+            if not input:
+                return []
+
+            missing = [text for text in input if text not in cache]
+            if not missing:
+                logger.info("[embedding] ✓ n=%d docs served from cache (task=%s).",
+                            len(input), task)
+                return [cache[text] for text in input]
+
+            body = json.dumps({
+                "instances": [{"task_type": task, "content": text} for text in missing]
+            }).encode()
+
+            started = time.monotonic()
+            for attempt in range(1, QUOTA_MAX_ATTEMPTS + 1):
+                try:
+                    payload = _post(url, body, state["token"])
+                    break
+                except urllib.error.HTTPError as exc:
+                    if exc.code == 401 and attempt == 1:
+                        # Worth one re-read: gcloud may mint a fresh one, or the
+                        # file may have been updated while the load ran. If the
+                        # token comes back unchanged there is nothing to retry.
+                        logger.info("[embedding] token rejected — re-reading it.")
+                        stale = state["token"]
+                        state["token"] = access_token()
+                        if state["token"] != stale:
+                            continue
+                        raise RuntimeError(
+                            f"Vertex rejected the token and {_token_file()} still holds "
+                            f"the same one — it has expired (they last about an hour). "
+                            f"Put a fresh token in that file and run again."
+                        ) from exc
+                    if exc.code == 429 and attempt < QUOTA_MAX_ATTEMPTS:
+                        pause = _retry_after(exc, attempt)
+                        logger.warning(
+                            "[embedding] quota exhausted (attempt %d/%d) — waiting "
+                            "%.0fs before retrying n=%d docs.",
+                            attempt, QUOTA_MAX_ATTEMPTS, pause, len(missing),
+                        )
+                        time.sleep(pause)
+                        continue
+                    detail = exc.read().decode(errors="replace")[:400]
+                    raise RuntimeError(f"Vertex HTTP {exc.code}: {detail}") from exc
+
+            vectors = [p["embeddings"]["values"] for p in payload["predictions"]]
+            logger.info(
+                "[embedding] ✓ embedded n=%d docs in %.2fs (task=%s, dims=%d)%s.",
+                len(vectors), time.monotonic() - started, task,
+                len(vectors[0]) if vectors else 0,
+                f", {len(input) - len(missing)} from cache" if len(missing) != len(input) else "",
+            )
+
+            if not caching:
+                # Nothing was cached, so `missing` is the whole input.
+                return vectors
+            cache.update(zip(missing, vectors))
+            _save_cache(cache)
+            return [cache[text] for text in input]
+
+    return _LocalVertexFn()
