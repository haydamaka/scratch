+"""Table records from a file, for running without the corporate network."""
+
+from __future__ import annotations
+
+from app.core.logger import get_logger
+from app.rag.retriever_base import JsonRetriever
+
+logger = get_logger(__name__)
+
+
+class LocalTableInfoRetriever(JsonRetriever):
+    """Records identical in shape to ``get_table_persona_schema()``'s return
+    value, so the loader cannot tell the two apart."""
+
+    env_var = "TABLE_INFO_JSON"
+    default_path = "data/table_catalog.json"
+
+    async def fetch(self) -> list[dict]:
+        # A record with no table name has no id to store under, and the loader
+        # would raise on it one frame later.
+        records = await super().fetch()
+        named = [r for r in records if (r.get("tableName") or "").strip()]
+        if len(named) != len(records):
+            logger.warning(
+                "[table_info] %s: %d record(s) without a table name were dropped.",
+                self.source, len(records) - len(named),
+            )
+        return named
