diff --git a/app/rag/retriever_base.py b/app/rag/retriever_base.py
new file mode 100644
index 0000000..e6000a0
--- /dev/null
+++ b/app/rag/retriever_base.py
@@ -0,0 +1,102 @@
+from __future__ import annotations
+
+import json
+import os
+from enum import Enum
+from pathlib import Path
+from typing import Protocol
+
+from app.core.logger import get_logger
+
+logger = get_logger(__name__)
+
+RECORD_SOURCE_ENV = "RECORD_SOURCE"
+
+
+class RecordSource(str, Enum):
+    SERVICE = "service"     # the training-intelligence service
+    JSON = "json"           # files on disk
+
+
+_DEFAULT_SOURCE = RecordSource.SERVICE
+
+
+class RecordRetriever(Protocol):
+    #: Named in the load log so a run always says what it read.
+    source: str
+
+    async def fetch(self) -> list[dict]:
+        """Return the raw records, in the shape the service returns them."""
+
+
+def read_records(path: "str | Path") -> list[dict]:
+    """Read records from a JSON array, a ``{"data": [...]}`` wrapper, or JSONL."""
+    path = Path(path)
+    if not path.is_absolute():
+        # Anchored to the project root, so the working directory cannot decide
+        # which catalog gets loaded.
+        path = (Path(__file__).resolve().parents[2] / path).resolve()
+    if not path.exists():
+        raise FileNotFoundError(f"No record file at {path}")
+
+    text = path.read_text(encoding="utf-8")
+    if path.suffix == ".jsonl":
+        records = [json.loads(line) for line in text.splitlines() if line.strip()]
+    else:
+        parsed = json.loads(text)
+        records = parsed.get("data", []) if isinstance(parsed, dict) else parsed
+
+    return [record for record in records if isinstance(record, dict)]
+
+
+class JsonRetriever:
+    """Records from a file. Subclasses supply the env var and the default path.
+
+    The two file-backed retrievers differ only in where they look, so that is all
+    a subclass states.
+    """
+
+    env_var: str = ""
+    default_path: str = ""
+
+    def __init__(self, path: "str | Path | None" = None) -> None:
+        self.path = Path(path or os.getenv(self.env_var) or self.default_path)
+        self.source = f"json: {self.path}"
+
+    async def fetch(self) -> list[dict]:
+        return read_records(self.path)
+
+
+# —— which retriever this deployment gets ——————————————————————————
+
+def selected_source() -> RecordSource:
+    value = os.getenv(RECORD_SOURCE_ENV)
+    if not value:
+        return _DEFAULT_SOURCE
+    try:
+        return RecordSource(value.strip().lower())
+    except ValueError:
+        raise ValueError(
+            f"Unknown {RECORD_SOURCE_ENV}={value!r}. Expected one of: "
+            f"{', '.join(s.value for s in RecordSource)}."
+        )
+
+
+def get_table_info_retriever() -> RecordRetriever:
+    """The table-record retriever this deployment is configured for."""
