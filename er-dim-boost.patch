 # reachability test, not a ranking, so ask for all of them.
 _ALL_CONNECTIONS = 10_000
 
+# —— Scoring weights ————————————————————————————————————————————————
+# Each term below is normalised to [0, 1], so a weight is directly the number
+# of "rank places" it is worth. The three boosts sum to _W_RANK on purpose:
+# everything going right for a candidate can at most fully compensate for
+# sitting at the bottom of the pool, and never more. A dimension table ranked
+# last can therefore reach — but not exceed — an unboosted table ranked first.
+_W_RANK    = float(os.getenv("ER_W_RANK",    "1.0"))
+_W_DIM     = float(os.getenv("ER_W_DIM",     "0.5"))
+_W_ANCHORS = float(os.getenv("ER_W_ANCHORS", "0.3"))
+_W_CONF    = float(os.getenv("ER_W_CONF",    "0.2"))
+
+# Anchors a candidate must join before corroboration saturates. Joining three
+# of the head's tables is strong evidence of a genuine join dependency;
+# past that it says little more.
+_CORROBORATION_SPAN = int(os.getenv("ER_CORROBORATION_SPAN", "3"))
+
+# Snapshot/versioning suffixes that sit *after* the dim/fact marker.
+_SNAPSHOT_SUFFIXES = {"actv", "active", "curr", "current", "hist", "vw", "v"}
+
+_RE_SEGMENT = re.compile(r"[^a-z0-9]+")
+
 
 def _normalize(table: str) -> str:
     """Graph nodes are stored lowercased and stripped."""
     return (table or "").lower().strip()
 
 
-def _neighbours(graph, table: str) -> "set[str]":
