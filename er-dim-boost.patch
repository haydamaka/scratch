+def is_dim_table(table: str) -> bool:
+    """True when any segment of the table's name marks it as a dimension.
+
+    Deliberately not ``get_related_tables._is_dim_table``, which tests
+    ``endswith("dim")`` and so classifies ``dim_entity`` as a dimension but
+    not ``dim_entity_actv`` — and the ``_actv`` snapshots are most of the
+    dimensions in this catalogue. Matching a whole ``dim`` segment anywhere in
+    the name covers both, while still rejecting ``fact_amounts``.
+    """
+    name = _RE_SEGMENT.split(_normalize(table).split(".")[-1])
+    return "dim" in name
+
+
+def _neighbours(graph, table: str) -> "dict[str, float]":
+    """``{neighbour: best edge confidence}`` for every table sharing an edge."""
     info = graph.get_table_connections(table, max_connections=_ALL_CONNECTIONS)
     if not info.get("exists"):
-        return set()
+        return {}
 
-    found: "set[str]" = set()
+    found: "dict[str, float]" = {}
     for edge in info.get("connections") or ():
         # Outgoing edges name the far end 'target_table', incoming ones
-        # 'source_table'; direction is irrelevant for reachability.
+        # 'source_table'; direction is irrelevant for joinability.
         other = edge.get("target_table") or edge.get("source_table")
-        if other:
-            found.add(_normalize(other))
+        if not other:
+            continue
+        key = _normalize(other)
+        confidence = float(edge.get("confidence") or 0.0)
+        found[key] = max(found.get(key, 0.0), confidence)
     return found
 
 
+def _score(
+    position: int,
+    n_tail: int,
+    table: str,
+    anchor_count: int,
+    confidence: float,
+) -> float:
+    """Rank a tail candidate on text rank, dimension-ness, corroboration, confidence.
+
+    ``position`` is the candidate's 0-based index within the tail, so the term
+    is 1.0 for the best-ranked survivor and decays to 0 at the bottom of the
+    pool. The other three terms are the reasons to overrule that ordering:
+
+    dimension     A fact table in the head joins its dimensions — that is the
+                  shape of the schema, and the dimensions carry the codes and
+                  descriptions a question filters on. They are also cheap to
+                  include and expensive to omit: a missing dimension breaks the
+                  join, an unused one is ignored.
+    corroboration A table joined to several of the head's tables is far more
+                  likely to be a real dependency of this query than one hanging
+                  off a single anchor.
+    confidence    The graph's own estimate of the relationship's quality, so an
+                  inferred or weak edge admits a table less readily than a
+                  declared key.
+    """
+    rank_term = 1.0 - (position / n_tail) if n_tail else 0.0
+    dim_term  = 1.0 if is_dim_table(table) else 0.0
+    corr_term = min(1.0, max(0, anchor_count - 1) / max(1, _CORROBORATION_SPAN))
+
+    return (
+        _W_RANK    * rank_term
+        + _W_DIM     * dim_term
+        + _W_ANCHORS * corr_term
+        + _W_CONF    * max(0.0, min(1.0, confidence))
+    )
+
